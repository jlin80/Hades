# =============================================================================
# HADES — Environment configuration (single source of truth)
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every setting the platform reads is declared here. No secret is ever hardcoded.
# Variables are grouped by bounded context / infrastructure concern.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE / RUNTIME
# -----------------------------------------------------------------------------
HADES_ENV=development                 # development | staging | production
HADES_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
HADES_LOG_FORMAT=json                 # json | console
HADES_INSTANCE_ID=hades-local-1       # unique per running node
HADES_TIMEZONE=UTC

# Global trading mode. The DECISION engine is identical in both; only the
# Execution Engine adapter differs. NEVER let a config file silently flip to live.
HADES_TRADING_MODE=paper              # paper | live
HADES_LIVE_TRADING_ENABLED=false      # hard safety gate; must be true AND mode=live

# -----------------------------------------------------------------------------
# REST API (FastAPI)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_ENABLE_DOCS=true
API_AUTH_ENABLED=false                # authentication scaffolding (future phase)
# Which interface the API and dashboard ports are published on. Loopback by
# default: the API is unauthenticated and can change the trading mode, reset the
# Kill Switch and trip the Circuit Breaker, so 0.0.0.0 hands those to anything
# that can route to this host. Set a LAN or VPN address to reach it remotely.
API_BIND=127.0.0.1
DASHBOARD_BIND=127.0.0.1
API_AUTH_API_KEY=                     # required header value when auth is enabled

# -----------------------------------------------------------------------------
# POSTGRESQL (operational / write model — event store + command side)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hades
POSTGRES_USER=hades
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
# Assembled DSN (leave blank to auto-build from the parts above)
DATABASE_URL=

# -----------------------------------------------------------------------------
# REDIS (cache + event bus transport + pub/sub for read-model projections)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=

# Which event-bus transport to use. in_memory for tests/single-process,
# redis for multi-service deployments.
EVENT_BUS_TRANSPORT=redis             # in_memory | redis
EVENT_BUS_STREAM_PREFIX=hades.events

# -----------------------------------------------------------------------------
# CLICKHOUSE (analytical / read model — optional, prepared not required)
# -----------------------------------------------------------------------------
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=hades_analytics
CLICKHOUSE_USER=hades
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# OBSERVABILITY (Prometheus / metrics / tracing)
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
# Ship every process's log lines through Redis so the dashboard terminal shows
# the whole platform (above all the worker, which hosts the trading pipeline)
# and not just the API's own process. Degrades to per-process logs if Redis is down.
LOG_SHIPPING_ENABLED=true
METRICS_PORT=9100
TRACING_ENABLED=false
TRACING_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# SOLANA / RPC (consumed by Scanner, Market, Wallet, Execution)
# -----------------------------------------------------------------------------
SOLANA_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK_URLS=             # comma-separated backups
SOLANA_COMMITMENT=confirmed           # processed | confirmed | finalized
SOLANA_REQUEST_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# RPC MANAGER (multi-provider routing, health scoring, automatic failover)
# -----------------------------------------------------------------------------
# Declare every provider as a JSON array. The manager routes each call through
# the healthiest one, measures latency/failures continuously, respects each
# provider's rate limit, and fails over automatically. When empty it falls back
# to SOLANA_RPC_HTTP_URL so the platform always has one provider.
# Example:
# RPC_ENDPOINTS=[{"name":"helius","http_url":"https://mainnet.helius-rpc.com/?api-key=XXX","priority":10,"rate_limit_per_second":50},{"name":"quicknode","http_url":"https://xxx.solana-mainnet.quiknode.pro/XXX/","priority":20,"rate_limit_per_second":25},{"name":"self","http_url":"http://my-node:8899","priority":5,"rate_limit_per_second":100}]
RPC_ENDPOINTS=
RPC_REQUEST_TIMEOUT_SECONDS=12
RPC_MAX_ATTEMPTS=4                    # failover attempts across providers per call
RPC_LATENCY_EWMA_ALPHA=0.3           # latency-estimate smoothing
RPC_UNHEALTHY_AFTER_FAILURES=3       # consecutive failures before a provider is parked
RPC_RECOVERY_PROBE_SECONDS=30        # how often to retry a parked provider
RPC_DEGRADED_LATENCY_MS=1500         # above this latency a provider is "degraded"

# -----------------------------------------------------------------------------
# WALLET / SIGNER (Execution Engine, live mode only)
# -----------------------------------------------------------------------------
# NEVER put a real private key in a committed file. Provide it only in `.env`
# or, preferably, via a mounted secret / external signer.
WALLET_PUBLIC_KEY=
WALLET_KEYPAIR_PATH=/run/secrets/hades_wallet.json
WALLET_MAX_SOL_PER_TX=0.5

# -----------------------------------------------------------------------------
# SCANNER (discovery only — thresholds, not logic)
# -----------------------------------------------------------------------------
SCANNER_ENABLED=true
SCANNER_POLL_INTERVAL_SECONDS=5
# Discovery sources (one adapter each). Verified live 2026-07-26: pumpfun,
# raydium, dexscreener and orca answer 200; jupiter and meteora answer 404
# (their endpoints moved — override the URL below or leave them out).
# See docs/OPERATING.md for the status table.
SCANNER_SOURCES=pumpfun,raydium,dexscreener
# Per-source endpoint overrides as a JSON object. Each adapter ships a working
# default; this exists so pointing a source at a mirror, proxy or replacement
# API is a config change, not a code edit. The adapter's parser is unchanged,
# so a substitute endpoint must still return that source's payload shape.
# SCANNER_SOURCE_URLS={"dexscreener": "https://my-bridge.internal/dex"}
SCANNER_MIN_LIQUIDITY_USD=5000
SCANNER_MAX_TOKEN_AGE_MINUTES=1440
SCANNER_DEDUP_TTL_SECONDS=86400       # how long a mint stays "seen" (dedup window)
SCANNER_SOURCE_TIMEOUT_SECONDS=12

# -----------------------------------------------------------------------------
# ACQUISITION PIPELINE (parallel workers, bounded queue, backpressure, snapshots)
# -----------------------------------------------------------------------------
PIPELINE_WORKERS=4
PIPELINE_QUEUE_MAX_SIZE=2000          # bounded; drops oldest under backpressure
PIPELINE_STAGE_TIMEOUT_SECONDS=30
PIPELINE_SNAPSHOT_ENABLED=true        # History Builder writes token_snapshots
PIPELINE_SNAPSHOT_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# SECURITY ENGINE (rug/honeypot detection — fail-closed: doubt rejects)
# -----------------------------------------------------------------------------
SECURITY_HONEYPOT_ENABLED=true
SECURITY_HONEYPOT_PROBE_USD=50
# Jupiter's quote route, used to probe whether a token can actually be SOLD.
# This is the highest-leverage URL in the platform: if it stops answering, every
# token fails its sellability check and NOTHING is ever approved for trading —
# quietly, because an unreachable quote is treated as doubt rather than an error.
# It is configurable so a retired endpoint is an .env edit, not a release.
# `https://quote-api.jup.ag/v6/quote` was the old default; Jupiter retired that
# host and it no longer resolves (EAI_NODATA).
SECURITY_HONEYPOT_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
# THE threshold a token must clear to pass Security. This is the real one —
# see the note under SCORING_* below before reaching for that instead.
SECURITY_MIN_SECURITY_SCORE=60
# A token scoring within this buffer above the threshold, with too many
# analyzers short of data, is rejected as unproven rather than approved.
SECURITY_DOUBT_BUFFER=15
SECURITY_MAX_INSUFFICIENT_ANALYZERS=3

# -----------------------------------------------------------------------------
# SCORING ENGINE — RESERVED, NOT WIRED. These change nothing today.
# -----------------------------------------------------------------------------
# The `scoring` context has no runtime: nothing constructs it and no pipeline
# stage consults it, so every value below is inert. They are kept because the
# context is scaffolding for a later phase, and documented as dead so nobody
# spends an afternoon wondering why tightening them changed no behaviour.
#
# The names collide dangerously with the live settings, and both sides default
# to the same numbers, so the mistake is silent:
#
#   SCORING_MIN_SECURITY_SCORE  -> inert       SECURITY_MIN_SECURITY_SCORE  <- real
#   SCORING_MIN_WALLET_SCORE    -> inert       RISK_MAX_WALLET_RISK         <- real
#   SCORING_MIN_FINAL_SCORE     -> inert       RISK_MIN_PROB_ROI_POSITIVE   <- real
#                                              RISK_MIN_CONFIDENCE          <- real
#
# To change what actually gates a trade, edit the right-hand column.
SCORING_MIN_SECURITY_SCORE=60
SCORING_MIN_WALLET_SCORE=50
SCORING_MIN_FINAL_SCORE=70
SCORING_MODEL_REGISTRY_PATH=/app/models

# -----------------------------------------------------------------------------
# RISK MANAGER — the guardian of capital (the ONLY thing that may approve a trade)
# -----------------------------------------------------------------------------
RISK_ENABLED=true
# Position count / capital / sizing.
RISK_MAX_CONCURRENT_POSITIONS=5
RISK_MAX_PORTFOLIO_EXPOSURE_PCT=50
RISK_MAX_POSITION_SIZE_USD=100
RISK_MIN_POSITION_SIZE_USD=0.05
RISK_LIQUIDITY_RESERVE_PCT=35            # never commit the whole balance
RISK_RISK_PER_TRADE_PCT=2.0              # % of equity risked at max conviction
# Signal-quality gates.
RISK_MIN_PROB_ROI_POSITIVE=0.55
RISK_MIN_CONFIDENCE=0.40
RISK_MIN_DEVELOPER_SCORE=40
RISK_MAX_WALLET_RISK=70
RISK_MIN_LIQUIDITY_USD=5000
# Exposure caps (percentage of equity).
RISK_MAX_EXPOSURE_PER_TOKEN_PCT=20
RISK_MAX_EXPOSURE_PER_DEVELOPER_PCT=25
RISK_MAX_EXPOSURE_PER_CLUSTER_PCT=30
RISK_MAX_EXPOSURE_PER_STRATEGY_PCT=40
RISK_MAX_EXPOSURE_PER_NARRATIVE_PCT=35
RISK_MAX_EXPOSURE_PER_REGIME_PCT=60
RISK_MAX_CORRELATED_POSITIONS=3
# Trade-rate caps.
RISK_MAX_TRADES_PER_HOUR=20
RISK_MAX_TRADES_PER_HOUR_PER_STRATEGY=8
# Drawdown ceilings.
RISK_DAILY_MAX_LOSS_USD=200
RISK_DAILY_MAX_LOSS_PCT=10
RISK_WEEKLY_MAX_LOSS_PCT=20
RISK_MONTHLY_MAX_LOSS_PCT=35
RISK_DAILY_MAX_STOP_LOSSES=8
# Kill Switch (graduated).
RISK_KILL_SWITCH_ENABLED=true
RISK_CONSECUTIVE_LOSSES_REDUCE=3
RISK_CONSECUTIVE_LOSSES_HALT=5
RISK_HALT_MINUTES=60
RISK_SIZE_REDUCTION_FACTOR=0.5
RISK_DRAWDOWN_OBSERVATION_PCT=10
RISK_DRAWDOWN_PAPER_ONLY_PCT=20
RISK_DRAWDOWN_EMERGENCY_PCT=30
# Circuit Breaker.
RISK_CIRCUIT_BREAKER_ENABLED=true
RISK_MAX_CONSECUTIVE_ERRORS=5
RISK_MAX_RPC_LATENCY_MS=3000
RISK_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
# Per-strategy risk budget as "name:pct,name:pct" (empty = no per-strategy cap).
RISK_RISK_BUDGET_MAP=

# -----------------------------------------------------------------------------
# POSITION MANAGEMENT (Take Profit / Stop Loss / Trailing)
# -----------------------------------------------------------------------------
POSITION_DEFAULT_TAKE_PROFIT_PCT=40
POSITION_DEFAULT_STOP_LOSS_PCT=20
POSITION_TRAILING_ENABLED=true
POSITION_TRAILING_ACTIVATION_PCT=25
POSITION_TRAILING_DISTANCE_PCT=10

# -----------------------------------------------------------------------------
# MARKET / PRICE ORACLE
# -----------------------------------------------------------------------------
# The price feed behind two things: grounding a paper fill in a real price
# (without it every entry price is 1.0) and marking open positions to market so
# take-profit / stop-loss can be evaluated at all. Disabling it also disables
# the Position Monitor — an exit cannot be judged without a mark.
MARKET_PRICE_ORACLE_ENABLED=true
# Batch token endpoint the mint list is appended to. A replacement must return
# DexScreener's payload shape, or the oracle simply reports no price.
MARKET_PRICE_SOURCE_URL=https://api.dexscreener.com/latest/dex/tokens/
MARKET_PRICE_CACHE_TTL_SECONDS=15.0   # quotes are reused this long between fetches
MARKET_PRICE_TIMEOUT_SECONDS=8.0
MARKET_PRICE_BATCH_SIZE=30            # DexScreener accepts up to 30 mints per request

# -----------------------------------------------------------------------------
# EXECUTION ENGINE
# -----------------------------------------------------------------------------
EXECUTION_ENABLED=true
EXECUTION_SLIPPAGE_BPS=100            # base/floor tolerance on a healthy pool (1.00%)
EXECUTION_MAX_SLIPPAGE_BPS=300        # per-order budget; an order is cancelled if exceeded
EXECUTION_HARD_MAX_SLIPPAGE_BPS=500   # absolute ceiling regardless of the order
EXECUTION_PRIORITY_FEE_MICROLAMPORTS=50000
EXECUTION_CONFIRMATION_TIMEOUT_SECONDS=30
EXECUTION_CONFIRMATION_POLL_SECONDS=1.0
EXECUTION_RETRY_MAX_ATTEMPTS=3        # bounded — never retries a live send forever
EXECUTION_RETRY_BASE_DELAY_SECONDS=0.5
EXECUTION_DEX_FEE_BPS=25              # aggregator/DEX fee charged in both paper and live
EXECUTION_SOL_PRICE_USD=150.0         # used to price network/priority fees in USD
EXECUTION_JITO_ENABLED=false         # scaffolded — Jito bundle tip (off by default)
EXECUTION_JITO_TIP_MICROLAMPORTS=0
# Quote mint the live path trades the token against (USDC by default).
EXECUTION_QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
EXECUTION_STATUS_INTERVAL_SECONDS=5.0
# The Position Monitor: marks open positions to market and fires the exits the
# Risk Manager already approved (take-profit / stop-loss / trailing). With it
# off, positions are opened and NEVER closed — leave it on.
EXECUTION_POSITION_MONITOR_ENABLED=true
EXECUTION_POSITION_MONITOR_INTERVAL_SECONDS=5.0
# Paper simulation knobs (used when HADES_TRADING_MODE=paper)
PAPER_STARTING_BALANCE_USD=1000
PAPER_SIMULATED_LATENCY_MS=250
PAPER_SIMULATED_SLIPPAGE_BPS=80

# -----------------------------------------------------------------------------
# FILTERS / LISTS
# -----------------------------------------------------------------------------
BLACKLIST_TOKENS=                     # comma-separated mint addresses
BLACKLIST_DEPLOYERS=                  # comma-separated deployer addresses
WHITELIST_TOKENS=

# -----------------------------------------------------------------------------
# NOTIFICATIONS (Discord ONLY — no Telegram/Slack/email. Always via events →
# the Notification Service. No module ever calls Discord directly.)
# -----------------------------------------------------------------------------
NOTIFY_DISCORD_ENABLED=false
NOTIFY_DISCORD_WEBHOOK_URL=
NOTIFY_MIN_SEVERITY=info              # debug | info | warning | critical
NOTIFY_DISCORD_ALERTS_WEBHOOK_URL=    # optional dedicated channel for warnings/critical
NOTIFY_DISCORD_TRADES_WEBHOOK_URL=    # optional dedicated channel for trade events
NOTIFY_RETRY_ATTEMPTS=3
NOTIFY_RATE_LIMIT_PER_MINUTE=30
NOTIFY_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# WATCHDOG / HEALTH MONITOR (independent service; probes deps + host resources)
# -----------------------------------------------------------------------------
WATCHDOG_ENABLED=true
WATCHDOG_HEARTBEAT_INTERVAL_SECONDS=10
WATCHDOG_UNHEALTHY_AFTER_MISSED_BEATS=3
WATCHDOG_PROBE_INTERVAL_SECONDS=15
WATCHDOG_CPU_MAX_PCT=90
WATCHDOG_MEMORY_MAX_PCT=90
WATCHDOG_DISK_MAX_PCT=90
WATCHDOG_RPC_LATENCY_MAX_MS=2000
WATCHDOG_API_HEALTH_URL=http://api:8000/health
WATCHDOG_DASHBOARD_URL=http://dashboard:5173/
WATCHDOG_WATCHED_ROLES=worker,engine,scheduler,notification
WATCHDOG_LIVENESS_DIR=/var/run/hades
WATCHDOG_LIVENESS_MAX_AGE_SECONDS=60

# -----------------------------------------------------------------------------
# DASHBOARD (React control center)
# -----------------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5173
DASHBOARD_TITLE=Hades Control Center
DASHBOARD_WS_PATH=/ws
DASHBOARD_REFRESH_INTERVAL_MS=5000

# -----------------------------------------------------------------------------
# SCHEDULER (periodic jobs: health probes, backups, retrain, cleanup)
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_INTERVAL_SECONDS=5
SCHEDULER_HEALTH_PROBE_INTERVAL_SECONDS=15
SCHEDULER_BACKUP_INTERVAL_HOURS=24
SCHEDULER_RETRAIN_INTERVAL_HOURS=24
SCHEDULER_CLEANUP_INTERVAL_HOURS=6

# -----------------------------------------------------------------------------
# BACKUPS (automatic + restorable: DB, config, models, research, docs)
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_DIRECTORY=/app/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_INCLUDE_DATABASE=true
BACKUP_INCLUDE_CONFIG=true
BACKUP_INCLUDE_MODELS=true
BACKUP_INCLUDE_RESEARCH=true
BACKUP_INCLUDE_DOCS=true
BACKUP_INCLUDE_LOGS=false

# -----------------------------------------------------------------------------
# LOGGING (structured JSON, rotation, per-domain files; also stdout for Docker)
# -----------------------------------------------------------------------------
LOG_DIRECTORY=/var/log/hades
LOG_TO_FILE=true
LOG_ROTATION_MAX_BYTES=50000000
LOG_ROTATION_BACKUPS=10
LOG_RING_BUFFER_SIZE=2000

# -----------------------------------------------------------------------------
# FEATURE ENGINE (feature store location & batching — no logic yet)
# -----------------------------------------------------------------------------
FEATURE_ENABLED=true
FEATURE_STORE_PATH=/app/datasets/features
FEATURE_BATCH_SIZE=256
FEATURE_CACHE_TTL_SECONDS=300
FEATURE_SCHEMA_VERSION=1              # bump when a feature definition changes (keeps old vectors readable)
FEATURE_HISTORY_WINDOW=64            # snapshots the technical features look back on

# -----------------------------------------------------------------------------
# LEARNING / IA (model registry & datasets — never auto-promotes)
# -----------------------------------------------------------------------------
LEARNING_ENABLED=true
LEARNING_RETRAIN_INTERVAL_HOURS=24
LEARNING_MODELS_PATH=/app/models
LEARNING_DATASETS_PATH=/app/datasets

# -----------------------------------------------------------------------------
# KNOWLEDGE (permanent memory — records everything, decides nothing)
# -----------------------------------------------------------------------------
# The Knowledge context stores what every other context learns and — the reason
# it exists — pairs each decision with its realised outcome, which is what gives
# the AI Committee ground-truth training samples. It has no concept of an order,
# a position or a trading mode, and an AST test forbids it importing one.
KNOWLEDGE_ENABLED=true
# Forward completed lessons to the committee's outcome ledger. This is the switch
# that closes the learning loop. Turning it off leaves the memory intact and the
# brain unable to learn from it — which is exactly the state the platform was in
# before this context existed, so leave it on unless you mean it.
KNOWLEDGE_FEED_COMMITTEE=true
# Publish an event per accepted observation. Off by default: the Scanner is a
# firehose and nothing subscribes, so this is thousands of bus messages an hour
# consumed by no one.
KNOWLEDGE_ANNOUNCE_OBSERVATIONS=false
KNOWLEDGE_DEFAULT_QUERY_DAYS=30

# -----------------------------------------------------------------------------
# RESEARCH LAB (offline R&D on COPIED data — NO path to execution)
# -----------------------------------------------------------------------------
RESEARCH_LAB_ENABLED=false
RESEARCH_DIR=/app/research
RESEARCH_DATASETS_PATH=/app/datasets
# Inbox for candidate bundles produced by the external Hades Research Lab (a
# separate repository and stack). An operator drops bundles here; the importer
# registers them as TRAINED candidates. Promotion stays a separate human action.
# See docs/RESEARCH_LAB_BRIDGE.md.
RESEARCH_CANDIDATE_INBOX=/app/research/inbox
# Shadow strategies mirror live features (virtual, zero-capital); scheduler runs
# recurring studies/reports. NONE of these can enable live trading.
#
# Turning the lab on takes BOTH flags. RESEARCH_LAB_ENABLED alone starts the
# runtime — the dashboard reports "Running" and shadow strategies populate — but
# runs no studies, so Experiments / Backtests / Reports stay permanently empty
# and the lab looks broken when it is merely idle. RESEARCH_AUTO_RESEARCH is
# what schedules the recurring work.
#
# Even then the first pass defers until the committee's outcome ledger holds
# RESEARCH_MIN_SAMPLES labelled outcomes (logged as `auto_research_deferred`);
# on a fresh deployment that wait is real. Lower it to see the lab work sooner,
# at the cost of studies drawn from a thin sample.
RESEARCH_SHADOW_ENABLED=true
RESEARCH_AUTO_RESEARCH=false
RESEARCH_MIN_SAMPLES=200
RESEARCH_STATUS_INTERVAL_SECONDS=10
RESEARCH_SHADOW_PUBLISH_INTERVAL_SECONDS=60
RESEARCH_DISCORD_ENABLED=true
# Promotion bar (a recommendation only — deployment is always a human action).
RESEARCH_PROMO_MIN_TRADES=500
RESEARCH_PROMO_MIN_SHARPE=1.0
RESEARCH_PROMO_MAX_DRAWDOWN=0.25
RESEARCH_PROMO_MIN_PROFIT_FACTOR=1.3

# -----------------------------------------------------------------------------
# STRATEGY ENGINE (modular strategies — DETECT ONLY, never execute or bypass risk)
# -----------------------------------------------------------------------------
STRATEGY_ENABLED=true
# Shadow-stage strategies are recorded + evaluated but excluded from the ensemble.
STRATEGY_SHADOW_ENABLED=true
# Ensemble fusion: |net conviction| must exceed the deadband to become a decision;
# alerts fire only on ensembles at least this confident.
STRATEGY_DECISION_DEADBAND=0.12
STRATEGY_MIN_NOTIFY_CONFIDENCE=0.5
# Dynamic weighting: a weak/degrading strategy is muted this low, never to zero.
STRATEGY_WEIGHT_FLOOR=0.05
STRATEGY_RESEARCH_BOOST=1.0
# Failsafe: consecutive errors before a strategy is temporarily muted.
STRATEGY_ERROR_THRESHOLD=3
# Global sensitivity dial (>1 = quicker to fire); per-strategy params can override.
STRATEGY_SENSITIVITY=1.0
# Comma-separated strategy names to force-disable at load (e.g. mean_reversion).
STRATEGY_DISABLED=
# Per-strategy parameter overrides as JSON, e.g.
#   {"momentum_breakout": {"sensitivity": 1.2}, "launch_detection": {"min_security_score": 70}}
STRATEGY_PARAMS=
# Forward-looking: let the ensemble gate the Risk Manager (default OFF — advisory).
STRATEGY_GATE_RISK=false
STRATEGY_STATUS_INTERVAL_SECONDS=5

# -----------------------------------------------------------------------------
# TIMEOUTS (seconds)
# -----------------------------------------------------------------------------
TIMEOUT_HTTP_SECONDS=15
TIMEOUT_DATABASE_SECONDS=10
TIMEOUT_REDIS_SECONDS=5
TIMEOUT_RPC_SECONDS=15
TIMEOUT_WEBSOCKET_SECONDS=30
TIMEOUT_SHUTDOWN_GRACE_SECONDS=20

# -----------------------------------------------------------------------------
# PATHS (Docker-volume-backed; everything here survives restarts)
# -----------------------------------------------------------------------------
PATH_LOGS=/var/log/hades
PATH_CONFIG=/app/config
PATH_MODELS=/app/models
PATH_BACKUPS=/app/backups
PATH_DOCS=/app/docs
PATH_DATASETS=/app/datasets
PATH_RESEARCH=/app/research
